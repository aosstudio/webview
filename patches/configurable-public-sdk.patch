Allow selecting the public SDK used by the AIDL build action

The primary SDK arguments already select the SDK for most Android actions.
AIDL and several other build actions deliberately use the public SDK
selection. Allow that selection to point to the independently provisioned
SDK while preserving Chromium's default public SDK paths and versions.

--- a/build/config/android/config.gni
+++ b/build/config/android/config.gni
@@ -160,9 +160,12 @@
 
   android_ndk_root = "//third_party/android_toolchain/ndk"
 
-  public_android_sdk_root = "//third_party/android_sdk/public"
-  public_android_sdk_platform_version = "37.0"
-  public_android_sdk_build_tools_version = "37.0.0"
+  declare_args() {
+    public_android_sdk_root = "//third_party/android_sdk/public"
+    public_android_sdk_platform_version = "37.0"
+    public_android_sdk_build_tools_version = "37.0.0"
+  }
+
   if (android_sdk_release == "public") {
     default_android_sdk_root = public_android_sdk_root
     default_android_sdk_platform_version = public_android_sdk_platform_version
