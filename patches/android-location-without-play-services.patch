Allow Android geolocation to use the platform provider alone

Preserve the default provider selection and JNI entry points. The
standalone WebView pilot can omit the Play Services location library
while using Android location and its existing permission checks.

--- a/build/config/android/config.gni
+++ b/build/config/android/config.gni
@@ -237,6 +237,9 @@
   declare_args() {
     android_ndk_api_level = default_min_sdk_version
 
+    # Compile the Google Play Services location provider into Android builds.
+    enable_google_play_services_location = true
+
     if (current_cpu == "riscv64" && default_min_sdk_version < 37) {
       # The Android NDK sysroot only provides RISC-V 64 libraries for API 37+.
       android_ndk_api_level = 37
