+
+@NullMarked
+final class ShapeDetectionBackend {
+    private ShapeDetectionBackend() {}
+
+    static @Nullable BarcodeDetectionProvider createBarcodeDetectionProvider() {
+        return null;
+    }
+
+    static FaceDetection createFaceDetection(FaceDetectorOptions options) {
+        return new FaceDetectionImpl(options);
+    }
+
+    static @Nullable TextDetection createTextDetection() {
