+// Copyright 2017 The Chromium Authors
+// Copyright 2026 AOSStudio contributors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.shape_detection;
+
+import android.graphics.Bitmap;
+
+import com.google.android.gms.vision.Frame;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.gms.ChromiumPlayServicesAvailability;
+import org.chromium.shape_detection.mojom.BarcodeDetectionProvider;
+import org.chromium.shape_detection.mojom.FaceDetection;
+import org.chromium.shape_detection.mojom.FaceDetectorOptions;
+import org.chromium.shape_detection.mojom.TextDetection;
+import org.chromium.skia.mojom.BitmapN32;
+
+@NullMarked
+final class ShapeDetectionBackend {
+    private ShapeDetectionBackend() {}
+
+    static @Nullable BarcodeDetectionProvider createBarcodeDetectionProvider() {
+        return BarcodeDetectionProviderImpl.create();
+    }
+
+    static FaceDetection createFaceDetection(FaceDetectorOptions options) {
+        if (ChromiumPlayServicesAvailability.isGooglePlayServicesAvailable(
+                ContextUtils.getApplicationContext())) {
+            return new FaceDetectionImplGmsCore(options);
+        }
+        return new FaceDetectionImpl(options);
+    }
+
+    static @Nullable TextDetection createTextDetection() {
+        return TextDetectionImpl.create();
+    }
+
+    static @Nullable Frame convertToFrame(BitmapN32 bitmapData) {
+        Bitmap bitmap = BitmapUtils.convertToBitmap(bitmapData);
+        if (bitmap == null) return null;
+
+        // Building the frame converts the bitmap to YUV.
+        return new Frame.Builder().setBitmap(bitmap).build();
+    }
+}
